#!/usr/bin/env python3
"""Report the median pixel value of the central area of FITS/XISF images."""

from __future__ import annotations

import argparse
import math
import os
import statistics
import struct
import sys
import xml.etree.ElementTree as ET

FITS_EXT = {".fit", ".fits", ".fts"}
XISF_EXT = {".xisf"}
DEFAULT_AREA = 10.0
CHANNEL_NAMES = {1: [""], 3: ["R", "G", "B"]}

FITS_CODES = {8: "B", 16: "h", 32: "i", 64: "q", -32: "f", -64: "d"}
XISF_CODES = {
    "UInt8": "B",
    "Int8": "b",
    "UInt16": "H",
    "Int16": "h",
    "UInt32": "I",
    "Int32": "i",
    "UInt64": "Q",
    "Float32": "f",
    "Float64": "d",
}


class ImageError(Exception):
    pass


class Image:
    """Minimal pixel accessor: geometry plus a struct format for raw samples."""

    def __init__(self, path, offset, width, height, channels, code, byteorder, bzero, bscale):
        self.path = path
        self.offset = offset
        self.width = width
        self.height = height
        self.channels = channels
        self.code = code
        self.byteorder = byteorder
        self.bzero = bzero
        self.bscale = bscale
        self.itemsize = struct.calcsize(code)

    def read_region(self, fh, channel: int, x0: int, y0: int, w: int, h: int) -> list[float]:
        prefix = ">" if self.byteorder == "big" else "<"
        unpack = struct.Struct(f"{prefix}{w}{self.code}").unpack
        row_bytes = self.width * self.itemsize
        plane = self.offset + channel * self.height * row_bytes
        values: list[float] = []
        for row in range(y0, y0 + h):
            fh.seek(plane + row * row_bytes + x0 * self.itemsize)
            data = fh.read(w * self.itemsize)
            if len(data) < w * self.itemsize:
                raise ImageError("truncated image data")
            values.extend(unpack(data))
        if self.bzero or self.bscale != 1:
            values = [self.bzero + self.bscale * v for v in values]
        return values


def _unquote(value: str) -> str:
    value = value.strip()
    if len(value) >= 2 and value[0] == "'" and value[-1] == "'":
        value = value[1:-1].replace("''", "'").strip()
    return value


def _parse_card(card: str) -> tuple[str, str] | None:
    key = card[:8].strip()
    if not key or key in ("COMMENT", "HISTORY", "END") or card[8:10] != "= ":
        return None
    return key, _unquote(card[10:].split("/", 1)[0])


def open_fits(path: str, fh) -> Image:
    cards: dict[str, str] = {}
    offset = 0
    while True:
        block = fh.read(2880)
        if len(block) < 2880:
            raise ImageError("truncated header")
        text = block.decode("latin-1")
        for i in range(0, 2880, 80):
            card = text[i : i + 80]
            if card[:8].strip() == "END":
                offset = fh.tell()
                break
            parsed = _parse_card(card)
            if parsed:
                cards.setdefault(*parsed)
        if offset:
            break

    def num(key: str, default: float | None = None) -> float:
        if key not in cards:
            if default is None:
                raise ImageError(f"missing required keyword {key}")
            return default
        return float(cards[key])

    naxis = int(num("NAXIS"))
    if naxis not in (2, 3):
        raise ImageError(f"unsupported NAXIS={naxis}")
    bitpix = int(num("BITPIX"))
    if bitpix not in FITS_CODES:
        raise ImageError(f"unsupported BITPIX={bitpix}")
    return Image(
        path,
        offset,
        int(num("NAXIS1")),
        int(num("NAXIS2")),
        int(num("NAXIS3", 1)) if naxis == 3 else 1,
        FITS_CODES[bitpix],
        "big",
        num("BZERO", 0),
        num("BSCALE", 1),
    )


def open_xisf(path: str, fh) -> Image:
    if fh.read(8) != b"XISF0100":
        raise ImageError("not a monolithic XISF file")
    (length,) = struct.unpack("<I", fh.read(4))
    fh.seek(4, os.SEEK_CUR)  # reserved
    root = ET.fromstring(fh.read(length).decode("utf-8", "replace"))

    image = next((e for e in root.iter() if e.tag.rsplit("}", 1)[-1] == "Image"), None)
    if image is None:
        raise ImageError("no image found")
    if image.get("compression"):
        raise ImageError("compressed XISF data is not supported")

    location = (image.get("location") or "").split(":")
    if location[0] != "attachment":
        raise ImageError(f"unsupported data location '{image.get('location')}'")

    geometry = [int(v) for v in (image.get("geometry") or "").split(":")]
    if len(geometry) != 3:
        raise ImageError("unsupported image geometry")

    fmt = image.get("sampleFormat") or ""
    if fmt not in XISF_CODES:
        raise ImageError(f"unsupported sample format {fmt}")

    return Image(
        path,
        int(location[1]),
        geometry[0],
        geometry[1],
        geometry[2],
        XISF_CODES[fmt],
        image.get("byteOrder", "little"),
        0,
        1,
    )


def center_medians(path: str, fraction: float) -> tuple[list[float], tuple[int, int]]:
    opener = open_xisf if os.path.splitext(path)[1].lower() in XISF_EXT else open_fits
    with open(path, "rb") as fh:
        image = opener(path, fh)
        scale = math.sqrt(fraction)
        w = max(1, round(image.width * scale))
        h = max(1, round(image.height * scale))
        x0 = (image.width - w) // 2
        y0 = (image.height - h) // 2
        medians = [
            statistics.median(image.read_region(fh, c, x0, y0, w, h))
            for c in range(image.channels)
        ]
    return medians, (w, h)


def collect_files(target: str, recursive: bool) -> list[str]:
    if os.path.isfile(target):
        return [target]
    if not os.path.isdir(target):
        raise FileNotFoundError(target)
    known = FITS_EXT | XISF_EXT
    if recursive:
        return sorted(
            os.path.join(root, n)
            for root, _, names in os.walk(target)
            for n in names
            if os.path.splitext(n)[1].lower() in known
        )
    return sorted(
        os.path.join(target, n)
        for n in os.listdir(target)
        if os.path.splitext(n)[1].lower() in known
        and os.path.isfile(os.path.join(target, n))
    )


def format_value(value: float) -> str:
    return str(int(value)) if float(value).is_integer() else f"{value:.4f}"


def print_table(rows: list[list[str]], headers: list[str], separator: str | None) -> None:
    if separator is not None:
        for row in [headers] + rows:
            print(separator.join(row))
        return
    widths = [len(h) for h in headers]
    for row in rows:
        widths = [max(w, len(c)) for w, c in zip(widths, row)]
    print("  ".join(h.ljust(w) for h, w in zip(headers, widths)).rstrip())
    print("  ".join("-" * w for w in widths).rstrip())
    for row in rows:
        print("  ".join(c.ljust(w) for c, w in zip(row, widths)).rstrip())


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="fitsmedian",
        description="Median pixel value of the central area of FITS/XISF images.",
    )
    parser.add_argument("path", help="FITS/XISF file or directory containing them")
    parser.add_argument(
        "-a",
        "--area",
        type=float,
        default=DEFAULT_AREA,
        metavar="PERCENT",
        help=f"percentage of the image area to measure (default: {DEFAULT_AREA:g})",
    )
    parser.add_argument(
        "-r", "--recursive", action="store_true", help="search directories recursively"
    )
    parser.add_argument(
        "-c", "--csv", action="store_true", help="output comma-separated values"
    )
    parser.add_argument(
        "-f", "--full-path", action="store_true", help="print full paths instead of names"
    )
    args = parser.parse_args(argv)

    if not 0 < args.area <= 100:
        parser.error("--area must be between 0 and 100")

    try:
        files = collect_files(args.path, args.recursive)
    except FileNotFoundError:
        print(f"fitsmedian: no such file or directory: {args.path}", file=sys.stderr)
        return 1
    if not files:
        print(f"fitsmedian: no FITS/XISF files found in {args.path}", file=sys.stderr)
        return 1

    rows: list[list[str]] = []
    channels = 1
    failures = 0
    for path in files:
        try:
            medians, (w, h) = center_medians(path, args.area / 100.0)
        except (ImageError, OSError, struct.error) as exc:
            print(f"fitsmedian: {path}: {exc}", file=sys.stderr)
            failures += 1
            continue
        channels = max(channels, len(medians))
        name = path if args.full_path else os.path.basename(path)
        rows.append([name, f"{w}x{h}"] + [format_value(m) for m in medians])

    if rows:
        names = CHANNEL_NAMES.get(channels, [str(i + 1) for i in range(channels)])
        headers = ["FILE", "REGION"] + [
            f"MEDIAN{'_' + n if n else ''}" for n in names
        ]
        width = len(headers)
        rows = [row + ["-"] * (width - len(row)) for row in rows]
        print_table(rows, headers, "," if args.csv else None)

    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main())
