#!/usr/bin/env python3
"""Report median pixel values of the centre and corner areas of FITS/XISF images."""

from __future__ import annotations

import argparse
import math
import os
import shlex
import statistics
import struct
import sys
import xml.etree.ElementTree as ET

FITS_EXT = {".fit", ".fits", ".fts"}
XISF_EXT = {".xisf"}
DEFAULT_AREA = 10.0
DEFAULT_SAMPLES = 100_000
DEFAULT_THRESHOLD = 3.0
REGIONS = ["CENTER", "TL", "TR", "BL", "BR"]
COLUMNS = REGIONS + ["SUM"]
MAD_TO_SIGMA = 1.4826
HIGHLIGHT = "\033[1;31m"
RESET = "\033[0m"

FITS_CODES = {8: "B", 16: "h", 32: "i", 64: "q", -32: "f", -64: "d"}
XISF_CODES = {
    "UInt8": "B",
    "Int8": "b",
    "UInt16": "H",
    "Int16": "h",
    "UInt32": "I",
    "Int32": "i",
    "UInt64": "Q",
    "Float32": "f",
    "Float64": "d",
}


class ImageError(Exception):
    pass


class Image:
    """Minimal pixel accessor: geometry plus a struct format for raw samples."""

    def __init__(self, path, offset, width, height, channels, code, byteorder, bzero, bscale):
        self.path = path
        self.offset = offset
        self.width = width
        self.height = height
        self.channels = channels
        self.code = code
        self.byteorder = byteorder
        self.bzero = bzero
        self.bscale = bscale
        self.itemsize = struct.calcsize(code)

    def read_region(
        self, fh, channel: int, x0: int, y0: int, w: int, h: int, step: int = 1
    ) -> list[float]:
        prefix = ">" if self.byteorder == "big" else "<"
        unpack = struct.Struct(f"{prefix}{w}{self.code}").unpack
        row_bytes = self.width * self.itemsize
        plane = self.offset + channel * self.height * row_bytes
        values: list[float] = []
        for row in range(y0, y0 + h, step):
            # whole 2x2 blocks keep CFA (Bayer) images sampled in their native proportions
            for line in (row, row + 1) if step > 1 else (row,):
                if line >= y0 + h:
                    break
                fh.seek(plane + line * row_bytes + x0 * self.itemsize)
                data = fh.read(w * self.itemsize)
                if len(data) < w * self.itemsize:
                    raise ImageError("truncated image data")
                samples = unpack(data)
                if step > 1:
                    values.extend(samples[0::step])
                    values.extend(samples[1::step])
                else:
                    values.extend(samples)
        if self.bzero or self.bscale != 1:
            values = [self.bzero + self.bscale * v for v in values]
        return values


def _unquote(value: str) -> str:
    value = value.strip()
    if len(value) >= 2 and value[0] == "'" and value[-1] == "'":
        value = value[1:-1].replace("''", "'").strip()
    return value


def _parse_card(card: str) -> tuple[str, str] | None:
    key = card[:8].strip()
    if not key or key in ("COMMENT", "HISTORY", "END") or card[8:10] != "= ":
        return None
    return key, _unquote(card[10:].split("/", 1)[0])


def open_fits(path: str, fh) -> Image:
    cards: dict[str, str] = {}
    offset = 0
    while True:
        block = fh.read(2880)
        if len(block) < 2880:
            raise ImageError("truncated header")
        text = block.decode("latin-1")
        for i in range(0, 2880, 80):
            card = text[i : i + 80]
            if card[:8].strip() == "END":
                offset = fh.tell()
                break
            parsed = _parse_card(card)
            if parsed:
                cards.setdefault(*parsed)
        if offset:
            break

    def num(key: str, default: float | None = None) -> float:
        if key not in cards:
            if default is None:
                raise ImageError(f"missing required keyword {key}")
            return default
        return float(cards[key])

    naxis = int(num("NAXIS"))
    if naxis not in (2, 3):
        raise ImageError(f"unsupported NAXIS={naxis}")
    bitpix = int(num("BITPIX"))
    if bitpix not in FITS_CODES:
        raise ImageError(f"unsupported BITPIX={bitpix}")
    return Image(
        path,
        offset,
        int(num("NAXIS1")),
        int(num("NAXIS2")),
        int(num("NAXIS3", 1)) if naxis == 3 else 1,
        FITS_CODES[bitpix],
        "big",
        num("BZERO", 0),
        num("BSCALE", 1),
    )


def open_xisf(path: str, fh) -> Image:
    if fh.read(8) != b"XISF0100":
        raise ImageError("not a monolithic XISF file")
    (length,) = struct.unpack("<I", fh.read(4))
    fh.seek(4, os.SEEK_CUR)  # reserved
    root = ET.fromstring(fh.read(length).decode("utf-8", "replace"))

    image = next((e for e in root.iter() if e.tag.rsplit("}", 1)[-1] == "Image"), None)
    if image is None:
        raise ImageError("no image found")
    if image.get("compression"):
        raise ImageError("compressed XISF data is not supported")

    location = (image.get("location") or "").split(":")
    if location[0] != "attachment":
        raise ImageError(f"unsupported data location '{image.get('location')}'")

    geometry = [int(v) for v in (image.get("geometry") or "").split(":")]
    if len(geometry) != 3:
        raise ImageError("unsupported image geometry")

    fmt = image.get("sampleFormat") or ""
    if fmt not in XISF_CODES:
        raise ImageError(f"unsupported sample format {fmt}")

    return Image(
        path,
        int(location[1]),
        geometry[0],
        geometry[1],
        geometry[2],
        XISF_CODES[fmt],
        image.get("byteOrder", "little"),
        0,
        1,
    )


def region_medians(
    path: str, fraction: float, max_samples: int
) -> tuple[dict[str, float], tuple[int, int], int]:
    """Median of each sampled region, pooled over all channels."""
    opener = open_xisf if os.path.splitext(path)[1].lower() in XISF_EXT else open_fits
    with open(path, "rb") as fh:
        image = opener(path, fh)
        scale = math.sqrt(fraction)
        w = max(1, round(image.width * scale))
        h = max(1, round(image.height * scale))
        pixels = w * h * image.channels
        blocks = 1 if max_samples <= 0 else max(1, math.isqrt(pixels // max(1, max_samples)))
        step = 1 if blocks == 1 else 2 * blocks
        right = (image.width - w) & ~1  # even origins keep CFA blocks aligned
        bottom = (image.height - h) & ~1
        origins = {
            "CENTER": (right // 2 & ~1, bottom // 2 & ~1),
            "TL": (0, 0),
            "TR": (right, 0),
            "BL": (0, bottom),
            "BR": (right, bottom),
        }
        medians = {}
        for region, (x0, y0) in origins.items():
            values: list[float] = []
            for channel in range(image.channels):
                values += image.read_region(fh, channel, x0, y0, w, h, step)
            medians[region] = statistics.median(values)
    return medians, (w, h), step


def collect_files(target: str, recursive: bool) -> list[str]:
    if os.path.isfile(target):
        return [target]
    if not os.path.isdir(target):
        raise FileNotFoundError(target)
    known = FITS_EXT | XISF_EXT
    if recursive:
        return sorted(
            os.path.join(root, n)
            for root, _, names in os.walk(target)
            for n in names
            if os.path.splitext(n)[1].lower() in known
        )
    return sorted(
        os.path.join(target, n)
        for n in os.listdir(target)
        if os.path.splitext(n)[1].lower() in known
        and os.path.isfile(os.path.join(target, n))
    )


def format_value(value: float) -> str:
    return str(int(value)) if float(value).is_integer() else f"{value:.4f}"


def outlier_flags(values: list[float], threshold: float) -> list[bool]:
    """Flag values further than `threshold` robust sigmas from the column median."""
    if len(values) < 3 or threshold <= 0:
        return [False] * len(values)
    middle = statistics.median(values)
    sigma = MAD_TO_SIGMA * statistics.median([abs(v - middle) for v in values])
    if sigma <= 0:
        return [False] * len(values)
    return [abs(v - middle) > threshold * sigma for v in values]


def print_table(rows: list[list[str]], headers: list[str], separator: str | None) -> None:
    if separator is not None:
        for row in [headers] + rows:
            print(separator.join(row))
        return

    def plain(text: str) -> str:
        return text.replace(HIGHLIGHT, "").replace(RESET, "")

    widths = [len(h) for h in headers]
    for row in rows:
        widths = [max(w, len(plain(c))) for w, c in zip(widths, row)]
    print("  ".join(h.ljust(w) for h, w in zip(headers, widths)).rstrip())
    print("  ".join("-" * w for w in widths).rstrip())
    for row in rows:
        cells = [c + " " * (w - len(plain(c))) for c, w in zip(row, widths)]
        print("  ".join(cells).rstrip())


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="fitsmedian",
        description="Median pixel values of the centre and corner areas of FITS/XISF images.",
    )
    parser.add_argument("path", help="FITS/XISF file or directory containing them")
    parser.add_argument(
        "-a",
        "--area",
        type=float,
        default=DEFAULT_AREA,
        metavar="PERCENT",
        help=f"total percentage of the image area to sample, split evenly between "
        f"the {len(REGIONS)} regions (default: {DEFAULT_AREA:g})",
    )
    parser.add_argument(
        "-s",
        "--sort",
        choices=COLUMNS,
        default="SUM",
        help="column used to sort the results (default: SUM)",
    )
    parser.add_argument(
        "-t",
        "--threshold",
        type=float,
        default=DEFAULT_THRESHOLD,
        metavar="SIGMA",
        help=f"outlier threshold in robust sigmas; 0 disables highlighting "
        f"(default: {DEFAULT_THRESHOLD:g})",
    )
    parser.add_argument(
        "-m",
        "--max-samples",
        type=int,
        default=DEFAULT_SAMPLES,
        metavar="N",
        help=f"approximate pixels read per region; 0 reads every pixel "
        f"(default: {DEFAULT_SAMPLES})",
    )
    parser.add_argument(
        "-r", "--recursive", action="store_true", help="search directories recursively"
    )
    parser.add_argument(
        "-c", "--csv", action="store_true", help="output comma-separated values"
    )
    parser.add_argument(
        "-f", "--full-path", action="store_true", help="print full paths instead of names"
    )
    parser.add_argument(
        "-n",
        "--no-rm-list",
        action="store_true",
        help="do not print the 'rm' command list",
    )
    args = parser.parse_args(argv)

    if not 0 < args.area <= 100:
        parser.error("--area must be between 0 and 100")

    try:
        files = collect_files(args.path, args.recursive)
    except FileNotFoundError:
        print(f"fitsmedian: no such file or directory: {args.path}", file=sys.stderr)
        return 1
    if not files:
        print(f"fitsmedian: no FITS/XISF files found in {args.path}", file=sys.stderr)
        return 1

    measurements: list[tuple[str, str, str, dict[str, float]]] = []
    failures = 0
    for path in files:
        try:
            medians, (w, h), step = region_medians(
                path, args.area / 100.0 / len(REGIONS), args.max_samples
            )
        except (ImageError, OSError, struct.error) as exc:
            print(f"fitsmedian: {path}: {exc}", file=sys.stderr)
            failures += 1
            continue
        medians["SUM"] = sum(medians[r] for r in REGIONS)
        name = path if args.full_path else os.path.basename(path)
        size = f"{w}x{h}" + (f"/{step}" if step > 1 else "")
        measurements.append((name, size, path, medians))

    measurements.sort(key=lambda item: item[3][args.sort], reverse=True)

    if measurements:
        colorize = not args.csv and sys.stdout.isatty()
        flags = {
            column: outlier_flags([m[3][column] for m in measurements], args.threshold)
            for column in COLUMNS
        }
        rows = []
        for i, (name, size, _, medians) in enumerate(measurements):
            cells = []
            for column in COLUMNS:
                text = format_value(medians[column])
                if flags[column][i] and not args.csv:
                    text = f"{HIGHLIGHT}{text}*{RESET}" if colorize else f"{text}*"
                cells.append(text)
            rows.append([name, size] + cells)

        headers = ["FILE", "SIZE"] + COLUMNS
        print_table(rows, headers, "," if args.csv else None)

        if not args.no_rm_list:
            print(f"\n# sorted by {args.sort}, highest first - review and run manually")
            for _, _, path, _ in measurements:
                print(f"rm {shlex.quote(path)}")

    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main())
